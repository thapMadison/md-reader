{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "es2023",
    // No "DOM". The Worker runs on workerd, not in a browser: it has fetch,
    // Request and Response but no window, document or localStorage. Leaving DOM
    // in would let code that cannot run here typecheck cleanly.
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // @types/node for the fetch/Request/Response globals, rather than
    // @cloudflare/workers-types. Node 20 implements the same WHATWG interfaces
    // this Worker uses, it is already a dependency, and it is what the tests
    // actually execute against — so the types match the thing being run. The
    // trade-off: Cloudflare-specific APIs (KV, Durable Objects, `caches.default`)
    // would not typecheck. That is acceptable while this Worker deliberately
    // uses none of them; reach for @cloudflare/workers-types the day it does.
    "types": ["node"],
    "skipLibCheck": true,

    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
