# Committed on purpose. Both values are public: the client id is sent to GitHub
# in the browser's address bar during sign-in, and the Worker URL is a public
# endpoint that refuses any origin outside its own allowlist.
#
# The client SECRET is not here and must never be. It lives only in the Worker,
# set with `wrangler secret put GITHUB_CLIENT_SECRET`.
#
# Override either value locally in `.env.local` (already gitignored via *.local)
# to point a dev build at a different OAuth App or Worker.
VITE_GITHUB_CLIENT_ID=Ov23li8awhxQHa7uGWwl
VITE_GIST_TOKEN_ENDPOINT=https://md-reader-gist-auth.thapnv.workers.dev
