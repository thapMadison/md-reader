{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MDReader theme file",
  "type": "object",
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name shown in the theme picker"
    },
    "mode": {
      "type": "string",
      "enum": [
        "light",
        "dark"
      ],
      "description": "Badge shown next to the theme name"
    },
    "tokens": {
      "type": "object",
      "description": "Partial map of token name -> value. Omitted tokens inherit from the base palette.",
      "properties": {
        "--bg": {
          "type": "string",
          "description": "Reading canvas background",
          "default": "#ffffff",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--chrome": {
          "type": "string",
          "description": "Toolbar, sidebar, and editor-pane background",
          "default": "#f6f8fa",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--border": {
          "type": "string",
          "description": "Hairline borders and dividers",
          "default": "#d1d9e0",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--code-bg": {
          "type": "string",
          "description": "Inline code and code-block background",
          "default": "#f6f8fa",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--quote-bg": {
          "type": "string",
          "description": "Blockquote background wash",
          "default": "rgba(9,105,218,0.05)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--hl": {
          "type": "string",
          "description": "Hover / active row highlight",
          "default": "rgba(9,105,218,0.08)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--edge-shadow": {
          "type": "string",
          "description": "Wide-table horizontal-scroll edge fade",
          "default": "rgba(31,35,40,0.12)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--surface-radius": {
          "type": "string",
          "description": "Corner radius for article surfaces (code, quotes, images); 0 for square corners",
          "default": "8px",
          "pattern": "^-?(\\d+\\.?\\d*|\\.\\d+)(em|rem|px|ch|ex)?$"
        },
        "--surface-corner": {
          "type": "string",
          "description": "Shape of article surface corners: rounded, or beveled (cut at 45°)",
          "default": "round",
          "enum": [
            "round",
            "bevel"
          ]
        },
        "--chrome-fg": {
          "type": "string",
          "description": "Primary text and icons on chrome surfaces",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--chrome-muted": {
          "type": "string",
          "description": "Secondary text and metadata on chrome surfaces",
          "default": "#59636e",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--chrome-border": {
          "type": "string",
          "description": "Hairlines and control outlines on chrome surfaces",
          "default": "#d1d9e0",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--chrome-hl": {
          "type": "string",
          "description": "Hover / active row highlight on chrome surfaces",
          "default": "rgba(9,105,218,0.08)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--chrome-accent-shape": {
          "type": "string",
          "description": "Active sidebar row highlight: rounded rectangle, or diagonal wedge",
          "default": "flat",
          "enum": [
            "flat",
            "wedge"
          ]
        },
        "--chrome-pattern": {
          "type": "string",
          "description": "Decorative pattern on toolbar and sidebar",
          "default": "none",
          "enum": [
            "none",
            "chevron",
            "rulework",
            "aura",
            "grain",
            "halftone",
            "notched",
            "unprinted",
            "figureground",
            "databend",
            "facet"
          ]
        },
        "--chrome-pattern-opacity": {
          "type": "string",
          "description": "Pattern strength, 0 to 0.15; 0.05 is the reference density",
          "default": "0.05",
          "pattern": "^-?(\\d+\\.?\\d*|\\.\\d+)(em|rem|px|ch|ex)?$"
        },
        "--chrome-pattern-ink": {
          "type": "string",
          "description": "Pattern ink: white (for dark chrome) or black (for light chrome)",
          "default": "light",
          "enum": [
            "light",
            "dark"
          ]
        },
        "--fg": {
          "type": "string",
          "description": "Primary text color",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--muted": {
          "type": "string",
          "description": "Secondary text, metadata, placeholders",
          "default": "#59636e",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--link": {
          "type": "string",
          "description": "Links, active states, primary accent",
          "default": "#0969da",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--body-fg": {
          "type": "string",
          "description": "Article body text",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h1-fg": {
          "type": "string",
          "description": "Level-1 heading text",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h2-fg": {
          "type": "string",
          "description": "Level-2 heading text",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h3-fg": {
          "type": "string",
          "description": "Level-3 heading text",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h4-fg": {
          "type": "string",
          "description": "Level-4 heading text",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h5-fg": {
          "type": "string",
          "description": "Level-5 heading text",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h6-fg": {
          "type": "string",
          "description": "Level-6 heading text",
          "default": "#59636e",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--quote-accent": {
          "type": "string",
          "description": "Blockquote left accent bar",
          "default": "#0969da",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--quote-fg": {
          "type": "string",
          "description": "Blockquote body text",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--code-header-bg": {
          "type": "string",
          "description": "Code block header strip background",
          "default": "#f6f8fa",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--code-header-fg": {
          "type": "string",
          "description": "Code block language label and header text",
          "default": "#59636e",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--heading-accent": {
          "type": "string",
          "description": "Heading marker accent, leading tone",
          "default": "#0969da",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--heading-accent-soft": {
          "type": "string",
          "description": "Heading marker accent, trailing tone",
          "default": "rgba(9,105,218,0.35)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h2-accent": {
          "type": "string",
          "description": "Level-2 marker, leading tone",
          "default": "#0969da",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h2-accent-soft": {
          "type": "string",
          "description": "Level-2 marker, trailing tone",
          "default": "rgba(9,105,218,0.35)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h3-accent": {
          "type": "string",
          "description": "Level-3 marker, leading tone",
          "default": "#0969da",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h3-accent-soft": {
          "type": "string",
          "description": "Level-3 marker, trailing tone",
          "default": "rgba(9,105,218,0.35)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h4-accent": {
          "type": "string",
          "description": "Level-4 marker (single-tone chevron)",
          "default": "#0969da",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h4-accent-soft": {
          "type": "string",
          "description": "Level-4 marker, trailing tone (unused by the default shape)",
          "default": "rgba(9,105,218,0.35)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h5-accent": {
          "type": "string",
          "description": "Level-5 marker (diamond)",
          "default": "#0969da",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h5-accent-soft": {
          "type": "string",
          "description": "Level-5 marker, trailing tone (unused by the default shape)",
          "default": "rgba(9,105,218,0.35)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h6-accent": {
          "type": "string",
          "description": "Level-6 marker (hollow chevron)",
          "default": "#0969da",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--h6-accent-soft": {
          "type": "string",
          "description": "Level-6 marker, trailing tone (unused by the default shape)",
          "default": "rgba(9,105,218,0.35)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--heading-marker-style": {
          "type": "string",
          "description": "Heading marker glyphs: chevron family, diagonal wedge family, or hidden",
          "default": "chevron",
          "enum": [
            "chevron",
            "wedge",
            "off"
          ]
        },
        "--heading-marker": {
          "type": "string",
          "description": "Heading marker width when shown",
          "default": "0.52em",
          "pattern": "^-?(\\d+\\.?\\d*|\\.\\d+)(em|rem|px|ch|ex)?$"
        },
        "--heading-rule": {
          "type": "string",
          "description": "Underline rule beneath level-2 headings",
          "default": "#d1d9e0",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--badge-bg": {
          "type": "string",
          "description": "Inline code and chip background",
          "default": "#f6f8fa",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--table-style": {
          "type": "string",
          "description": "Table rule style: full grid, row rules only, or header rule only",
          "default": "grid",
          "enum": [
            "grid",
            "horizontal",
            "minimal"
          ]
        },
        "--table-radius": {
          "type": "string",
          "description": "Table outer corner radius; 0 for square corners",
          "default": "8px",
          "pattern": "^-?(\\d+\\.?\\d*|\\.\\d+)(em|rem|px|ch|ex)?$"
        },
        "--table-header-bg": {
          "type": "string",
          "description": "Table header row background",
          "default": "#f6f8fa",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--table-header-fg": {
          "type": "string",
          "description": "Table header row text",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--table-row-alt": {
          "type": "string",
          "description": "Alternating (even) table row background",
          "default": "rgba(9,105,218,0.03)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--table-row-hover": {
          "type": "string",
          "description": "Table row background on hover",
          "default": "rgba(9,105,218,0.06)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--table-border": {
          "type": "string",
          "description": "Table cell grid lines",
          "default": "#d1d9e0",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--table-border-width": {
          "type": "string",
          "description": "Table cell grid line thickness; 0 removes the grid",
          "default": "1px",
          "pattern": "^-?(\\d+\\.?\\d*|\\.\\d+)(em|rem|px|ch|ex)?$"
        },
        "--table-cell-pad-y": {
          "type": "string",
          "description": "Table cell padding, vertical",
          "default": "9px",
          "pattern": "^-?(\\d+\\.?\\d*|\\.\\d+)(em|rem|px|ch|ex)?$"
        },
        "--table-cell-pad-x": {
          "type": "string",
          "description": "Table cell padding, horizontal",
          "default": "14px",
          "pattern": "^-?(\\d+\\.?\\d*|\\.\\d+)(em|rem|px|ch|ex)?$"
        },
        "--table-font-size": {
          "type": "string",
          "description": "Table text size, relative to article body",
          "default": "0.88em",
          "pattern": "^-?(\\d+\\.?\\d*|\\.\\d+)(em|rem|px|ch|ex)?$"
        },
        "--math-fg": {
          "type": "string",
          "description": "Math formula text",
          "default": "#1f2328",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--math-bg": {
          "type": "string",
          "description": "Display-math ($$…$$) block background",
          "default": "rgba(9,105,218,0.04)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--danger": {
          "type": "string",
          "description": "Errors and destructive hover states",
          "default": "#cf222e",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--danger-bg": {
          "type": "string",
          "description": "Error banner / badge background wash",
          "default": "rgba(207,34,46,0.06)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--warn": {
          "type": "string",
          "description": "Warnings and caution callout accent",
          "default": "#9a6700",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--warn-bg": {
          "type": "string",
          "description": "Warning callout background wash",
          "default": "rgba(154,103,0,0.06)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--ok": {
          "type": "string",
          "description": "Success and tip callout accent",
          "default": "#1a7f37",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--ok-bg": {
          "type": "string",
          "description": "Success callout background wash",
          "default": "rgba(26,127,55,0.06)",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--syn-kw": {
          "type": "string",
          "description": "Syntax: keywords",
          "default": "#cf222e",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--syn-str": {
          "type": "string",
          "description": "Syntax: strings",
          "default": "#0a3069",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--syn-fn": {
          "type": "string",
          "description": "Syntax: function names",
          "default": "#8250df",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--syn-cm": {
          "type": "string",
          "description": "Syntax: comments",
          "default": "#6e7781",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--syn-num": {
          "type": "string",
          "description": "Syntax: numbers",
          "default": "#0550ae",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--syn-type": {
          "type": "string",
          "description": "Syntax: types and class names",
          "default": "#953800",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--syn-op": {
          "type": "string",
          "description": "Syntax: operators and punctuation",
          "default": "#0550ae",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--syn-var": {
          "type": "string",
          "description": "Syntax: variables and template substitutions",
          "default": "#953800",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--syn-attr": {
          "type": "string",
          "description": "Syntax: attributes, object keys, CSS selectors",
          "default": "#0550ae",
          "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})|(rgb|rgba|hsl|hsla|oklch)\\(.*\\))$"
        },
        "--syn-tag": {
          "type": "string",
          "description": "Syntax: HTML/XML tags and CSS element selectors",
          "default": "#116329",
